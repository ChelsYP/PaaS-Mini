# Kredensial dan Keamanan Dashboard
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Integrasi Nginx Proxy Manager (NPM) API
NPM_URL=http://npm:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme

# Konfigurasi Jaringan & Domain
DOCKER_NETWORK=npm_default
PUBLIC_DOMAIN=chelsa.me
LOCAL_DOMAIN=paas.local

# Batasan Alokasi Resource Kontainer
DEFAULT_MEM_MB=256
DEFAULT_CPU=0.5
MAX_APPS_PER_USER=5

# Database SQLite
DB_PATH=data/paas.db

